DATABASE_URL="file:./dev.db"

# Довгий випадковий рядок (не менше 32 символів)
SESSION_SECRET=""

# Обліковий запис головного адміністратора, який створює 
pm run db:seed
SEED_ADMIN_EMAIL="admin@kryla.local"
SEED_ADMIN_PASSWORD=""

# local — рейси з власної бази; у майбутньому: назва GDS-постачальника
FLIGHT_PROVIDER="local"
# demo — тестова оплата без списання коштів; у майбутньому: платіжний сервіс
PAYMENT_PROVIDER="demo"